  <fielddef name="application-id" size="4" unit="octet"> </fielddef>
  <fielddef name="HbH-id" size="4" unit="octet"> </fielddef>
  <fielddef name="EtE-id" size="4" unit="octet"> </fielddef>
</header>

<body>
