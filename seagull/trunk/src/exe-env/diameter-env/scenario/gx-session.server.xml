<!--
  Diameter Gx (3GPP TS 29.212) - lado servidor (PCRF simulado), sesion completa.
  Flujo: CER/CEA -> CCR-I/CCA-I -> RAR/RAA -> CCR-U/CCA-U -> CCR-T/CCA-T. DWR/DWA en <default>.
  El RAR usa HbH/EtE propios (contadores 5000/6000) y se dirige al PCEF guardado del CCR-I.
  Entre VMs: ajustar Host-IP-Address (0x0001 + IPv4 en hex) y "source" en conf.server.xml.
-->

<?xml version="1.0" encoding="ISO-8859-1" ?>
<scenario>

<counter>
  <counterdef name="HbH-counter" init="5000"> </counterdef>
  <counterdef name="EtE-counter" init="6000"> </counterdef>
</counter>

<init>
  <receive channel="channel-1">
    <command name="CER"> </command>
  </receive>
  <send channel="channel-1">
    <command name="CEA">
      <avp name="Result-Code" value="2001"> </avp>
      <avp name="Origin-Host" value="pcrf.example.com"> </avp>
      <avp name="Origin-Realm" value="example.com"> </avp>
      <avp name="Host-IP-Address" value="0x00017f000001"> </avp> <!-- 127.0.0.1 -->
      <avp name="Vendor-Id" value="10415"> </avp>
      <avp name="Product-Name" value="Seagull-Gx-Server"> </avp>
      <avp name="Supported-Vendor-Id" value="10415"> </avp>
      <avp name="Vendor-Specific-Application-Id">
        <avp name="Vendor-Id" value="10415"> </avp>
        <avp name="Auth-Application-Id" value="16777238"> </avp>
      </avp>
      <avp name="Firmware-Revision" value="1"> </avp>
    </command>
  </send>
</init>

<traffic>
  <!-- 1. CCR-Initial: guardar ids, sesion y datos del PCEF para el RAR -->
  <receive channel="channel-1">
    <command name="CCR">
      <avp name="Session-Id" value="dont_care"> </avp>
      <avp name="CC-Request-Type" value="1"> </avp>
      <avp name="CC-Request-Number" value="0"> </avp>
    </command>
    <action>
      <store name="HbH" entity="HbH-id"> </store>
      <store name="E2E" entity="EtE-id"> </store>
      <store name="sid" entity="Session-Id"> </store>
      <store name="pcef" entity="Origin-Host"> </store>
      <store name="pcefRealm" entity="Origin-Realm"> </store>
      <check-value name="CC-Request-Type" behaviour="error"> </check-value>
      <check-value name="CC-Request-Number" behaviour="error"> </check-value>
    </action>
  </receive>

  <!-- 2. CCA-Initial: instala regla y suscribe QOS_CHANGE -->
  <send channel="channel-1">
    <action>
      <restore name="HbH" entity="HbH-id"> </restore>
      <restore name="E2E" entity="EtE-id"> </restore>
      <restore name="sid" entity="Session-Id"> </restore>
    </action>
    <command name="CCA">
      <avp name="Session-Id" value="will_be_erased"> </avp>
      <avp name="Auth-Application-Id" value="16777238"> </avp>
      <avp name="Origin-Host" value="pcrf.example.com"> </avp>
      <avp name="Origin-Realm" value="example.com"> </avp>
      <avp name="Result-Code" value="2001"> </avp>
      <avp name="CC-Request-Type" value="1"> </avp>
      <avp name="CC-Request-Number" value="0"> </avp>
      <avp name="Event-Trigger" value="1"> </avp>                  <!-- QOS_CHANGE -->
      <avp name="Charging-Rule-Install">
        <avp name="Charging-Rule-Name" value="rule_default_test"> </avp>
      </avp>
      <avp name="QoS-Information">
        <avp name="APN-Aggregate-Max-Bitrate-UL" value="50000000"> </avp>
        <avp name="APN-Aggregate-Max-Bitrate-DL" value="100000000"> </avp>
      </avp>
      <avp name="Default-EPS-Bearer-QoS">
        <avp name="QoS-Class-Identifier" value="9"> </avp>
        <avp name="Allocation-Retention-Priority">
          <avp name="Priority-Level" value="10"> </avp>
          <avp name="Pre-emption-Capability" value="1"> </avp>
          <avp name="Pre-emption-Vulnerability" value="1"> </avp>
        </avp>
      </avp>
      <avp name="Supported-Features">
        <avp name="Vendor-Id" value="10415"> </avp>
        <avp name="Feature-List-ID" value="1"> </avp>
        <avp name="Feature-List" value="2"> </avp>
      </avp>
    </command>
  </send>

  <!-- 3. RAR (iniciado por el PCRF): HbH/EtE nuevos, dirigido al PCEF del CCR-I -->
  <send channel="channel-1">
    <action>
      <inc-counter name="HbH-counter"> </inc-counter>
      <inc-counter name="EtE-counter"> </inc-counter>
      <set-value name="HbH-id" format="$(HbH-counter)"> </set-value>
      <set-value name="EtE-id" format="$(EtE-counter)"> </set-value>
      <restore name="sid" entity="Session-Id"> </restore>
      <restore name="pcef" entity="Destination-Host"> </restore>
      <restore name="pcefRealm" entity="Destination-Realm"> </restore>
    </action>
    <command name="RAR">
      <avp name="Session-Id" value="will_be_erased"> </avp>
      <avp name="Auth-Application-Id" value="16777238"> </avp>
      <avp name="Origin-Host" value="pcrf.example.com"> </avp>
      <avp name="Origin-Realm" value="example.com"> </avp>
      <avp name="Destination-Realm" value="value_is_replaced"> </avp>
      <avp name="Destination-Host" value="value_is_replaced"> </avp>
      <avp name="Re-Auth-Request-Type" value="0"> </avp>           <!-- AUTHORIZE_ONLY -->
      <avp name="Charging-Rule-Remove">
        <avp name="Charging-Rule-Name" value="rule_default_test"> </avp>
      </avp>
      <avp name="Charging-Rule-Install">
        <avp name="Charging-Rule-Name" value="rule_rar_test"> </avp>
      </avp>
    </command>
  </send>

  <!-- 4. RAA -->
  <receive channel="channel-1">
    <command name="RAA">
      <avp name="Result-Code" value="2001"> </avp>
    </command>
    <action>
      <check-value name="Result-Code" behaviour="error"> </check-value>
    </action>
  </receive>

  <!-- 5. CCR-Update -->
  <receive channel="channel-1">
    <command name="CCR">
      <avp name="Session-Id" value="dont_care"> </avp>
      <avp name="CC-Request-Type" value="2"> </avp>
      <avp name="CC-Request-Number" value="1"> </avp>
      <avp name="Event-Trigger" value="1"> </avp>
    </command>
    <action>
      <store name="HbH" entity="HbH-id"> </store>
      <store name="E2E" entity="EtE-id"> </store>
      <check-value name="CC-Request-Type" behaviour="error"> </check-value>
      <check-value name="CC-Request-Number" behaviour="error"> </check-value>
      <check-value name="Event-Trigger" behaviour="error"> </check-value>
    </action>
  </receive>

  <!-- 6. CCA-Update -->
  <send channel="channel-1">
    <action>
      <restore name="HbH" entity="HbH-id"> </restore>
      <restore name="E2E" entity="EtE-id"> </restore>
      <restore name="sid" entity="Session-Id"> </restore>
    </action>
    <command name="CCA">
      <avp name="Session-Id" value="will_be_erased"> </avp>
      <avp name="Auth-Application-Id" value="16777238"> </avp>
      <avp name="Origin-Host" value="pcrf.example.com"> </avp>
      <avp name="Origin-Realm" value="example.com"> </avp>
      <avp name="Result-Code" value="2001"> </avp>
      <avp name="CC-Request-Type" value="2"> </avp>
      <avp name="CC-Request-Number" value="1"> </avp>
    </command>
  </send>

  <!-- 7. CCR-Termination -->
  <receive channel="channel-1">
    <command name="CCR">
      <avp name="Session-Id" value="dont_care"> </avp>
      <avp name="CC-Request-Type" value="3"> </avp>
      <avp name="CC-Request-Number" value="2"> </avp>
      <avp name="Termination-Cause" value="1"> </avp>
    </command>
    <action>
      <store name="HbH" entity="HbH-id"> </store>
      <store name="E2E" entity="EtE-id"> </store>
      <check-value name="CC-Request-Type" behaviour="error"> </check-value>
      <check-value name="CC-Request-Number" behaviour="error"> </check-value>
      <check-value name="Termination-Cause" behaviour="error"> </check-value>
    </action>
  </receive>

  <!-- 8. CCA-Termination -->
  <send channel="channel-1">
    <action>
      <restore name="HbH" entity="HbH-id"> </restore>
      <restore name="E2E" entity="EtE-id"> </restore>
      <restore name="sid" entity="Session-Id"> </restore>
    </action>
    <command name="CCA">
      <avp name="Session-Id" value="will_be_erased"> </avp>
      <avp name="Auth-Application-Id" value="16777238"> </avp>
      <avp name="Origin-Host" value="pcrf.example.com"> </avp>
      <avp name="Origin-Realm" value="example.com"> </avp>
      <avp name="Result-Code" value="2001"> </avp>
      <avp name="CC-Request-Type" value="3"> </avp>
      <avp name="CC-Request-Number" value="2"> </avp>
    </command>
  </send>
</traffic>

<!-- Device-Watchdog: responder DWR del peer -->
<default>
  <receive channel="channel-1">
    <command name="DWR"> </command>
    <action>
      <store name="HbH" entity="HbH-id"> </store>
      <store name="E2E" entity="EtE-id"> </store>
    </action>
  </receive>
  <send channel="channel-1">
    <action>
      <restore name="HbH" entity="HbH-id"> </restore>
      <restore name="E2E" entity="EtE-id"> </restore>
    </action>
    <command name="DWA">
      <avp name="Result-Code" value="2001"> </avp>
      <avp name="Origin-Host" value="pcrf.example.com"> </avp>
      <avp name="Origin-Realm" value="example.com"> </avp>
    </command>
  </send>
</default>

</scenario>
